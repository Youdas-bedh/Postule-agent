# Base locale. Garder la base et les CV dans un volume persistant privé.
DATABASE_URL=sqlite:///data/postule.db
MAX_PROFILE_BYTES=1048576
MAX_CV_BYTES=15000000

# Provider LLM local. Aucun secret ni fournisseur payant n'est requis.
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8000/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=Qwen/Qwen3.5-9B
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=16384
# Paramètres du serveur vLLM et emplacement persistant des poids Hugging Face.
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
HF_HOME=/workspace/.cache/huggingface

# Source de recherche facultative ; ajouter la clé uniquement dans le fichier .env local.
COMPANY_SEARCH_API_URL=
COMPANY_SEARCH_API_KEY=
COMPANY_PUBLIC_LISTS_PATH=
COMPANY_ANALYSIS_MAX_TOKENS=1800

# Limites et seuils pour les scans publics et la stratégie de candidature.
CONTACT_MIN_CONFIDENCE=80
DIRECT_JOB_APPLICATION_THRESHOLD=75
CONTACT_SCAN_CACHE_DAYS=7
CONTACT_SCAN_TIMEOUT=8
CONTACT_SCAN_MAX_PAGES=10
DIRECT_APPLICATION_MIN_SCORE=70
SPONTANEOUS_COMPANY_MIN_SCORE=50
MIN_CONTACT_CONFIDENCE=80
CANDIDATE_STATUS=graduated

# Gmail outreach (safe defaults: no real send)
GMAIL_ENABLED=false
AUTO_SEND_ENABLED=false
AUTO_SEND_ON_DISCOVERY=false
EMAIL_DRY_RUN=true
DAILY_EMAIL_LIMIT=20
MIN_SEND_INTERVAL_SECONDS=45
ONLY_VERIFIED_CONTACTS=true
MAX_EMAILS_PER_COMPANY=1
GMAIL_CREDENTIALS_PATH=/workspace/postule-agent/secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=/workspace/postule-agent/secrets/gmail_token.json
